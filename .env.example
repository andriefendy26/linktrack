# Password untuk masuk ke dashboard
DASHBOARD_PASSWORD=ganti-password-ini
# Secret acak untuk sesi & hashing IP (isi string panjang acak)
APP_SECRET=ganti-dengan-string-acak-panjang
# URL publik aplikasi (untuk membentuk link tracking)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# "true" = simpan IP asli. Default "false" = IP disimpan sebagai hash saja
STORE_RAW_IP=false
